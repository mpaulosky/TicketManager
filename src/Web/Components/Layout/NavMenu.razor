
@inject IJSRuntime Js

<header class="app-header">
	<div class="flex items-center justify-between gap-3 px-4 py-3 md:px-6">
		<a href="/" class="app-brand">
			<span class="app-brand-mark">TM</span>
			Ticket Manager
		</a>

		<div class="flex items-center gap-3">
			<nav class="app-nav hidden items-center gap-2 md:flex">
				<a href="/" class="theme-nav-link">Overview</a>
				<a href="/repositories" class="theme-nav-link">Repositories</a>
				<a href="/about" class="theme-nav-link">About</a>
			</nav>
			<button type="button" class="theme-toggle"
			        aria-label="@(_isDarkMode ? "Switch to light theme" : "Switch to dark theme")"
			        title="@(_isDarkMode ? "Switch to light theme" : "Switch to dark theme")" @onclick="ToggleTheme">
				@(_isDarkMode ? "☀️" : "🌙")
			</button>
		</div>
	</div>
</header>

@code {
	private bool _isDarkMode;

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			var theme = await Js.InvokeAsync<string>("getTheme");
			var isDarkMode = string.Equals(theme, "dark", StringComparison.OrdinalIgnoreCase);
			if (_isDarkMode != isDarkMode)
			{
				_isDarkMode = isDarkMode;
				StateHasChanged();
			}
		}
	}

	private async Task ToggleTheme()
	{
		_isDarkMode = !_isDarkMode;
		await Js.InvokeVoidAsync("applyTheme", _isDarkMode ? "dark" : "light");
		StateHasChanged();
	}

}
