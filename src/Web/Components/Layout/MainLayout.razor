@inherits Microsoft.AspNetCore.Components.LayoutComponentBase

<div class="app-shell">
	<div class="app-page">
		<NavMenu />

		<main class="flex-1">
			<div class="app-content-shell">
				<article class="app-article">
					@Body
				</article>
			</div>
		</main>

		<Footer />
	</div>
</div>

<div id="blazor-error-ui">
	An unhandled error has occurred.
	<a href="" class="reload">Reload</a>
	<a class="dismiss">🗙</a>
</div>
