@page "/about"

<PageTitle>About</PageTitle>

<section class="app-page-stack">
	<div class="app-page-card">
		<div class="max-w-2xl">
			<p class="app-pill">About</p>
			<h1 class="app-h1">About TicketManager</h1>
			<p class="app-copy">
				TicketManager is a tool for managing GitHub Issues through GitHub Projects,
				built with .NET Aspire and Blazor. GitHub itself is the system of record —
				there is no local database or persisted copy of issue data.
			</p>
		</div>
	</div>
</section>
