# Claude Code OAuth token — get one by running `claude setup-token` on your host.
# Lets the agent use your Claude subscription instead of an API key.
CLAUDE_CODE_OAUTH_TOKEN=
# Or use an Anthropic API key instead — uncomment and fill in:
# ANTHROPIC_API_KEY=
#
# No GitHub token goes here. Sandcastle passes every key in this file into the
# sandbox, and agents that read issue text must not be able to reach GitHub.
# The host reads issues, pushes branches and opens pull requests with your own
# `gh auth login` and git credentials, and main.mts refuses to start while
# GH_TOKEN or GITHUB_TOKEN is set here.
