{
	"mcpServers": {
		"mongodb": {
			"type": "stdio",
			"command": "pnpm",
			"args": [
				"dlx",
				"mongodb-mcp-server@latest"
			]
		},
		"playwright": {
			"type": "stdio",
			"command": "pnpm",
			"args": [
				"dlx",
				"@playwright/mcp@latest"
			]
		},
		"microsoft-docs": {
			"type": "http",
			"url": "https://learn.microsoft.com/api/mcp"
		},
		"sequential-thinking": {
			"type": "stdio",
			"command": "pnpm",
			"args": [
				"dlx",
				"@modelcontextprotocol/server-sequential-thinking"
			]
		},
		"github": {
			"type": "stdio",
			"command": "pnpm",
			"args": [
				"dlx",
				"@anthropic/github-mcp-server"
			],
			"env": {
				"GITHUB_TOKEN": "${GITHUB_TOKEN}"
			}
		}
	}
}
